{
  "name": "dsh-reboot",
  "version": "0.2.1",
  "private": true,
  "type": "module",
  "description": "DS_RESTAR —— 给 DeepSeek Harness 的自助重启小部件：倒计时 → 结束进程 → 空档 → 自动拉起",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "watchdog",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "restart",
    "watchdog"
  ],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "inject": [],
      "immediately": true
    }
  },
  "manifestVersion": 1,
  "license": "MIT",
  "engines": {
    "node": ">=20"
  }
}
