{
  "name": "dsh-restar",
  "version": "0.3.0",
  "type": "module",
  "description": "DS_RESTAR —— 给 DeepSeek Harness 的自助重启小部件：倒计时 → 结束进程 → 空档 → 自动拉起",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "watchdog",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "dsh",
    "deepseek-harness",
    "dsh-plugin",
    "plugin",
    "restart",
    "watchdog",
    "windows"
  ],
  "homepage": "https://github.com/a1422398302aa-hash/dsh-restar#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/a1422398302aa-hash/dsh-restar.git"
  },
  "bugs": {
    "url": "https://github.com/a1422398302aa-hash/dsh-restar/issues"
  },
  "author": "MOLNG_ (a1422398302aa-hash)",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [],
      "immediately": true
    }
  },
  "manifestVersion": 1,
  "license": "MIT",
  "engines": {
    "node": ">=20"
  }
}
